{
  "name": "@rankone/eslint-plugin",
  "version": "0.2.0",
  "description": "RankOne ESLint plugin",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin"
  ],
  "files": [
    "dist",
    "docs",
    "package.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RankOneGlobal/eslint-plugin.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "lint": "eslint --ext .js,.ts src tests",
    "test": "jest",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "@typescript-eslint/utils": "5.62.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "eslint": "8.57.1",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "ts-jest": "29.4.15",
    "typescript": "5.1.6"
  },
  "peerDependencies": {
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RankOneGlobal/eslint-plugin/issues"
  },
  "homepage": "https://github.com/RankOneGlobal/eslint-plugin#readme",
  "directories": {
    "doc": "docs",
    "test": "tests"
  }
}
